{
  "manifest_version": 3,
  "name": "Tab Goblin",
  "version": "1.0.0",
  "description": "A goblin that puts tabs you ignored to sleep, and brings them back when you click them.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Tab Goblin" }
}
